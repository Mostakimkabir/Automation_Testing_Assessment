    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseBody = pm.response.json();\r",
              "\r",
              "pm.test(\"Validate status is 200\", ()=>{\r",
              "    pm.expect(pm.response.code).to.eql(200)\r",
              "})\r",
              "\r",
              "pm.environment.set(\"authToken\", responseBody.token);\r",
              "\r",
              "pm.test(\"Validate token generated\", ()=> {\r",
              "    pm.expect(responseBody.token).to.exist;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "free_user_3DiA16AyxiNPweUNELIkooCZwIW",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"eve.holt@reqres.in\",\r\n  \"password\": \"cityslicka\"\r\n}",
          "options": {
            "raw": {
